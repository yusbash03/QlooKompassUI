# Public build-time config only — every VITE_* value ships to the browser.
# The build fails if a VITE_* name contains SECRET, API_KEY, TOKEN, JWT, QLOO or LLM.

# Leave empty for same-origin /api (recommended; required for the refresh cookie).
VITE_API_BASE_URL=
VITE_APP_NAME=Kulture Compass
VITE_ENABLE_EVALUATION=false

# Dev only: where the Vite /api proxy forwards to (the deployed backend on Render).
# Local backend (`dotnet run` http profile):
# VITE_DEV_API_PROXY_TARGET=http://localhost:5206
VITE_DEV_API_PROXY_TARGET=https://kompass-api-hczs.onrender.com
